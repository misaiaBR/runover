# Export these variables in the shell/host. This file is not loaded automatically.
DATABASE_URL=sqlite:///./runover.db
# Generate a random value for production (do not use this example).
SECRET_KEY=replace-with-a-random-secret
MAIL_BACKEND=disabled
MAIL_FROM=
RESET_TOKEN_MINUTES=15
# Local Mailpit / SMTP:
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Gmail HTTPS / OAuth (no own domain required):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Render production email-code recovery (set these in the Render dashboard).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=RUNOVER!
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PUBLIC_APP_URL=https://runover.onrender.com
CORS_ALLOWED_ORIGINS=https://runover.onrender.com,http://localhost:8080
API_TIMEOUT_SECONDS=15
