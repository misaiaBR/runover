              }
            }
          ]
        }
      ]
    },
    {
      "name": "Encerramento",
      "description": "Fim destrutivo: exclui a conta criada no fluxo e prova que a sessão morreu.",
      "item": [
        {
          "name": "Delete My Account",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/me",
            "description": "204 apaga dados, libera territórios e invalida sessões. 409 se estiver em equipe (aqui já saiu)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Session Is Dead",
          "request": { "method": "GET", "url": "{{base_url}}/users/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('sessao morta da 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
