      "item": [
        {
          "name": "List Notifications",
          "request": { "method": "GET", "url": "{{base_url}}/notifications" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('eh lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Geolocalização",
      "item": [
        {
          "name": "Ping Location",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/location",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": -23.6489,\n  \"lng\": -46.8523\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
